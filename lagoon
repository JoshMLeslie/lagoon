class Store:
    def __init__(self):
        self.path = DIR / "history.jsonl"
        self.hist = []
        if self.path.exists():
            for line in self.path.read_text().splitlines():
                with contextlib.suppress(json.JSONDecodeError):
                    e = json.loads(line)
                    if isinstance(e, dict) and "mmd" in e:
                        self.hist.append(e)
        self.next_ver = (self.hist[-1]["ver"] + 1) if self.hist else 0
        self.merges_path = DIR / "merges.json"
        self.merges = []
        if self.merges_path.exists():
            with contextlib.suppress(json.JSONDecodeError):
                data = json.loads(self.merges_path.read_text())
                if isinstance(data, list):
                    self.merges = [
                        m for m in data
                        if isinstance(m, dict) and isinstance(m.get("id"), str)
                        and isinstance(m.get("charts"), list)
                    ]

    def register_merge(self, names):
        mid = "+".join(names)
        if not any(m["id"] == mid for m in self.merges):
            self.merges.append({"id": mid, "charts": list(names)})
            self.merges_path.write_text(json.dumps(self.merges))
        return mid

    def unregister_merge(self, mid):
        before = len(self.merges)
        self.merges = [m for m in self.merges if m["id"] != mid]
        if len(self.merges) != before:
            self.merges_path.write_text(json.dumps(self.merges))
            return True
        return False

    def append(self, name, mmd):
        entry = {"ver": self.next_ver, "name": name, "mmd": mmd, "at": utcnow()}
        self.next_ver += 1
        self.hist.append(entry)
        (DIR / "charts" / f"{name}.mmd").write_text(mmd)
        if len(self.hist) > HIST_KEEP:
            self.hist = self.hist[-HIST_KEEP * 4 // 5:]
            self.path.write_text("".join(json.dumps(e) + "\n" for e in self.hist))
        else:
            with self.path.open("a") as f:
                f.write(json.dumps(entry) + "\n")
        return entry


async def read_body(reader, headers):
    try:
        n = int(headers.get("content-length", "0"))
        return json.loads(await asyncio.wait_for(reader.readexactly(n), timeout=15) if n else b"{}")
    except (ValueError, asyncio.TimeoutError, asyncio.IncompleteReadError):
        return None


def reply_json(writer, obj):
    return reply(writer, "200 OK", "application/json", json.dumps(obj))


async def reply(writer, status, ctype, body):
    if isinstance(body, str):
        body = body.encode()
    writer.write(
        f"HTTP/1.1 {status}\r\nContent-Type: {ctype}\r\nContent-Length: {len(body)}\r\nConnection: close\r\n\r\n".encode()
        + body
    )
    await writer.drain()


