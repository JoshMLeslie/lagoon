async function renderPng() {
  if (splitNames()) return null;
  const e = viewList()[cursor];
  const svg = $("chart").querySelector("svg");
  if (!e || !svg) return null;
  const clone = svg.cloneNode(true);
  deForeign(clone);
  clone.querySelectorAll(".lagoon-handle, .lagoon-ghost").forEach((h) => h.remove());
  const bb = svg.getBBox();  // live content bounds: dragged elements stay in the export
  const w = Math.max(bb.width + bb.x * 2, 100), h = Math.max(bb.height + bb.y * 2, 100);
  clone.setAttribute("viewBox", bb.x + " " + bb.y + " " + bb.width + " " + bb.height);
  clone.setAttribute("width", w);
  clone.setAttribute("height", h);
  clone.removeAttribute("style");
  const xml = new XMLSerializer().serializeToString(clone);
  const url = URL.createObjectURL(new Blob([xml], { type: "image/svg+xml" }));
  try {
    const img = new Image();
    await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
    const dpr = 2;
    const cv = document.createElement("canvas");
    cv.width = Math.ceil(w * dpr);
    cv.height = Math.ceil(h * dpr);
    const ctx = cv.getContext("2d");
    ctx.fillStyle = "#0f1115";
    ctx.fillRect(0, 0, cv.width, cv.height);
    ctx.drawImage(img, 0, 0, cv.width, cv.height);
    return { dataUrl: cv.toDataURL("image/png"), fname: "lagoon-" + e.name + "-" + e.ver + ".png" };
  } catch (err) {
    show("png export failed: " + String(err));
    return null;
  } finally {
    URL.revokeObjectURL(url);
  }
}

async function savePng() {
  const out = await renderPng();
  if (!out) return;
  const api = topApi();
  if (api) {
    posSaved(await api.save_png(out.fname, out.dataUrl));
  } else {
    const a = document.createElement("a");
    a.href = out.dataUrl; a.download = out.fname; a.click();
    $("pos").textContent = "downloaded " + out.fname;
  }
}

async function copyPng() {
