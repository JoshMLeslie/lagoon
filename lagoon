}

function deForeign(root) {
  // WebKit taints the canvas if the drawn SVG contains a foreignObject,
  // and mermaid v11 emits them for labels even with htmlLabels:false.
  // Swap each for native <text> with the same lines and box.
  const NS = "http://www.w3.org/2000/svg";
  for (const fo of [...root.querySelectorAll("foreignObject")]) {
    const lines = [];
    for (const p of fo.querySelectorAll("p")) {
      for (const seg of p.innerHTML.split(/<br\s*\/?>/i)) {
        const t = seg.replace(/<[^>]*>/g, "").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&").trim();
        if (t) lines.push(t);
      }
    }
    if (!lines.length) {
      const t = fo.textContent.replace(/\s+/g, " ").trim();
      if (t) lines.push(t);
    }
    const w = parseFloat(fo.getAttribute("width")) || 0;
    const h = parseFloat(fo.getAttribute("height")) || 24;
    const n = lines.length || 1;
    const lh = h / n;
    const cls = fo.querySelector(".nodeLabel") ? "nodeLabel" : fo.querySelector(".edgeLabel") ? "edgeLabel" : "";
    const g = document.createElementNS(NS, "g");
    g.setAttribute("class", "label");
    if (lines.length) {
      const t = document.createElementNS(NS, "text");
      if (cls) t.setAttribute("class", cls);
      t.setAttribute("text-anchor", "middle");
      lines.forEach((ln, i) => {
        const ts = document.createElementNS(NS, "tspan");
        ts.setAttribute("x", w / 2);
        ts.setAttribute("y", h / 2 + (i - (n - 1) / 2) * lh + 6);
        ts.textContent = ln;
        t.appendChild(ts);
      });
      g.appendChild(t);
    }
    fo.replaceWith(g);
  }
}

const topApi = () => (window.pywebview && window.pywebview.api) ||
  (window.parent !== window && window.parent.pywebview && window.parent.pywebview.api);

function posSaved(path) {
  const pos = $("pos");
  pos.textContent = "";
  const b = document.createElement("button");
