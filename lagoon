function renderTabs() {
  const names = tabNames();
  const cur = currentTab();
  const wrap = $("tabs");
  wrap.innerHTML = "";
  for (const n of names) {
    const t = document.createElement("span");
    const isMerge = n.includes("+");
    const lastEntry = hist.filter((e) => e.name === n).at(-1);
    const unread = !isMerge && n !== "latest" && n !== cur && seenVer[n] !== undefined && lastEntry && lastEntry.ver > seenVer[n];
    t.className = "tab" + (n === cur ? " active" : "") + (selecting && selection.includes(n) ? " sel" : "");
    t.textContent = (unread ? "• " : "") + n;
    t.title = isMerge ? "merged view — right-click to remove" : "";
    if (selecting) {
      t.style.opacity = (n === "latest" || isMerge) ? 0.4 : 1;
      if (n !== "latest" && !isMerge) t.onclick = () => {
        const i = selection.indexOf(n);
