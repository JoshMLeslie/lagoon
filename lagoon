def icon_pdf():
    def rr(x0, y0, x1, y1, r):
        k = 0.5523 * r
        return (
            f"{x0+r:.1f} {y0:.1f} m "
            f"{x1-r:.1f} {y0:.1f} l "
            f"{x1-r+k:.1f} {y0:.1f} {x1:.1f} {y0+r-k:.1f} {x1:.1f} {y0+r:.1f} c "
            f"{x1:.1f} {y1-r+k:.1f} {x1-r+k:.1f} {y1:.1f} {x1-r:.1f} {y1:.1f} c "
            f"{x0+r:.1f} {y1:.1f} l "
            f"{x0+r-k:.1f} {y1:.1f} {x0:.1f} {y1-r+k:.1f} {x0:.1f} {y1-r:.1f} c "
            f"{x0:.1f} {y0+r-k:.1f} {x0+r-k:.1f} {y0:.1f} {x0+r:.1f} {y0:.1f} c h"
        )

    def circle(cx, cy, r):
        k = 0.5523 * r
        return (
            f"{cx:.1f} {cy+r:.1f} m "
            f"{cx+k:.1f} {cy+r:.1f} {cx+r:.1f} {cy+k:.1f} {cx+r:.1f} {cy:.1f} c "
            f"{cx+r:.1f} {cy-k:.1f} {cx+k:.1f} {cy-r:.1f} {cx:.1f} {cy-r:.1f} c "
            f"{cx-k:.1f} {cy-r:.1f} {cx-r:.1f} {cy-k:.1f} {cx-r:.1f} {cy:.1f} c "
            f"{cx-r:.1f} {cy+k:.1f} {cx-k:.1f} {cy+r:.1f} {cx:.1f} {cy+r:.1f} c h"
        )

    teal = "0.204 0.831 0.714"
    light = "0.906 0.929 0.953"
    stream = " ".join([
        "q",
        rr(72, 72, 952, 952, 200), "0.059 0.086 0.125 rg f W n",
        rr(180, 520, 430, 680, 30), light + " rg f",
        rr(600, 120, 850, 280, 30), light + " rg f",
        "430 600 m 560 600 500 320 660 292 c " + teal + " RG 26 w 1 J 1 j S",
        "700 292 m 654 318 l 656 264 l h " + teal + " rg f",
        circle(750, 560, 54), teal + " rg f",
        "Q",
    ])
    objs = [
        "<< /Type /Catalog /Pages 2 0 R >>",
        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
        "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 1024 1024] /Contents 4 0 R /Resources << >> >>",
        f"<< /Length {len(stream.encode())} >>\nstream\n{stream}\nendstream",
    ]
    out = bytearray(b"%PDF-1.4\n")
    offsets = []
    for i, body in enumerate(objs, 1):
        offsets.append(len(out))
        out += f"{i} 0 obj\n{body}\nendobj\n".encode()
    xref = len(out)
    out += f"xref\n0 {len(objs)+1}\n0000000000 65535 f \n".encode()
    for off in offsets:
        out += f"{off:010d} 00000 n \n".encode()
    out += f"trailer\n<< /Size {len(objs)+1} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF".encode()
    return bytes(out)


