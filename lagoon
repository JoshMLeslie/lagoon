async function renderEntry(i) {
  exitRebind();
  picked.clear();  // the rebuild replaces the DOM elements picked points at
  const list = viewList();
  cursor = Math.max(0, Math.min(i, list.length - 1));
  const e = list[cursor];
  renderTabs();
  if (!e) {
    show(pinned ? "no chart '" + pinned + "' yet — push it"
                : "nothing pushed yet — e.g. lagoon push demo < flow.mmd");
    $("name").textContent = pinned || "lagoon";
    return;
  }
  seenVer[e.name] = e.ver;
  $("name").textContent = e.name + " · " + new Date(e.at).toLocaleTimeString() + (pinned ? " · pinned" : "");
  $("pos").textContent = (cursor + 1) + "/" + list.length;
  if (typeof mermaid === "undefined")
    return show("mermaid.js unavailable — not cached and offline; run lagoon serve once while online");
  try {
    const out = await mermaid.render("g" + Date.now(), e.mmd);
