                    resp = {"ok": False, "error": f"no chart {name!r}"}
                else:
                    entry = self.store.append(name, chart.read_text())
                    await self.broadcast(entry)
                    resp = {"ok": True, "name": entry["name"], "ver": entry["ver"], "at": entry["at"]}
            elif parts[0] in ("compare", "merge"):
                names = parts[1:]
                if len(names) < 2 or any(not NAME_RE.match(n) for n in names):
                    resp = {"ok": False, "error": "compare needs 2+ valid chart names"}
                else:
                    mid = self.store.register_merge(names)
                    await self.broadcast({"type": "merges"})
                    if parts[0] == "compare":
                        await self.broadcast({"type": "split", "charts": names})
                    resp = {"ok": True, "id": mid, "charts": names, "panels": len(self.clients)}
            elif parts[0] == "unmerge":
                mid = parts[1] if len(parts) > 1 else ""
                if self.store.unregister_merge(mid):
                    await self.broadcast({"type": "merges"})
                    resp = {"ok": True, "removed": mid}
                else:
                    resp = {"ok": False, "error": f"no merged view {mid!r}"}
            elif parts[0] == "offsets":
                name = parts[1] if len(parts) > 1 else ""
                if not NAME_RE.match(name):
                    resp = {"ok": False, "error": "bad name"}
                else:
                    f = DIR / "charts" / f"{name}.offsets.json"
                    resp = {"ok": True, "offsets": json.loads(f.read_text()) if f.exists() else {}}
            elif parts[0] == "history":
                name = parts[1] if len(parts) > 1 else None
                if name and not NAME_RE.match(name):
                    resp = {"ok": False, "error": "bad name"}
                else:
                    src = self.store.hist if name is None else [e for e in self.store.hist if e["name"] == name]
                    entries = [{k: e[k] for k in ("ver", "name", "at")} for e in src][-50:]
                    resp = {"ok": True, "entries": entries}
            elif parts[0] == "list":
                resp = {
                    "ok": True,
                    "charts": sorted(p.stem for p in (DIR / "charts").glob("*.mmd")),
                    "current": self.store.hist[-1]["name"] if self.store.hist else None,
                    "merges": [m["id"] for m in self.store.merges],
                }
            else:
                resp = {"ok": False, "error": f"unknown command {parts[0]!r}"}
            writer.write((json.dumps(resp) + "\n").encode())
            await writer.drain()
        except (OSError, asyncio.TimeoutError):
            pass
        finally:
            with contextlib.suppress(Exception):
                writer.close()

    async def handle_http(self, reader, writer):
        try:
            first = b""
            headers = {}
            for _ in range(100):
                line = await asyncio.wait_for(reader.readline(), timeout=15)
                if not line or line in (b"\r\n", b"\n"):
                    break
                if first == b"" and line:
                    first = line
                else:
                    k, _, v = line.decode("latin-1").partition(":")
                    headers[k.strip().lower()] = v.strip()
            parts = first.decode("latin-1").split()
            method, path = (parts[0].upper(), parts[1].split("?", 1)[0]) if len(parts) >= 2 else ("", "")
            for kind, suffix in SIDECARS.items():
                if not path.startswith("/" + kind + "/"):
                    continue
                name = path[len(kind) + 2:]
                if bad_name(name):
                    return await reply(writer, "400 Bad Request", "text/plain", "bad name")
                f = DIR / "charts" / f"{name}{suffix}"
                if method == "POST":
                    obj = await read_body(reader, headers)
                    if obj is None or not isinstance(obj, dict):
                        return await reply(writer, "400 Bad Request", "text/plain", "bad payload")
                    f.write_text(json.dumps(obj))
                    return await reply(writer, "200 OK", "application/json", '{"ok": true}')
                if method != "GET":
                    return await reply(writer, "405 Method Not Allowed", "text/plain", "GET only")
                return await reply(writer, "200 OK", "application/json", f.read_text() if f.exists() else "{}")
            if method == "POST" and path.startswith("/chart/"):
                name = path[len("/chart/"):]
                if bad_name(name):
                    return await reply(writer, "400 Bad Request", "text/plain", "bad name")
                try:
                    n = int(headers.get("content-length", "0"))
                    data = await asyncio.wait_for(reader.readexactly(n), timeout=15) if n else b""
                except (ValueError, asyncio.TimeoutError, asyncio.IncompleteReadError):
                    return await reply(writer, "400 Bad Request", "text/plain", "bad body")
                mmd = data.decode("utf-8", "replace").strip("\n")
                if not mmd.strip():
                    return await reply(writer, "400 Bad Request", "text/plain", "no mermaid payload")
                entry = self.store.append(name, mmd)
                await self.broadcast(entry)
                return await reply(
                    writer, "200 OK", "application/json",
                    json.dumps({"ok": True, "name": entry["name"], "ver": entry["ver"]}),
                )
            if method == "POST" and path == "/merges":
                obj = await read_body(reader, headers)
                if obj is None:
                    return await reply(writer, "400 Bad Request", "text/plain", "bad body")
                charts = obj.get("charts") if isinstance(obj, dict) else None
                if (
                    not isinstance(charts, list) or len(charts) < 2
                    or any(not isinstance(c, str) or not NAME_RE.match(c) for c in charts)
                ):
                    return await reply(writer, "400 Bad Request", "text/plain", "charts must be 2+ valid names")
                mid = self.store.register_merge(charts)
                await self.broadcast({"type": "merges"})
                return await reply_json(writer, {"ok": True, "id": mid})
            if method == "POST" and path == "/unmerge":
                obj = await read_body(reader, headers)
                if obj is None:
                    return await reply(writer, "400 Bad Request", "text/plain", "bad body")
                mid = obj.get("id") if isinstance(obj, dict) else None
                if not isinstance(mid, str) or not self.store.unregister_merge(mid):
                    return await reply(writer, "404 Not Found", "text/plain", "no such merged view")
                await self.broadcast({"type": "merges"})
                return await reply(writer, "200 OK", "application/json", '{"ok": true}')
            if method != "GET":
                return await reply(writer, "405 Method Not Allowed", "text/plain", "GET only")
            if path == "/":
                return await reply(writer, "200 OK", "text/html; charset=utf-8", PAGE)
            if path == "/history":
                return await reply_json(writer, self.store.hist)
            if path == "/current":
                return await reply(
                    writer, "200 OK", "application/json",
                    json.dumps(self.store.hist[-1] if self.store.hist else None),
                )
            if path == "/mermaid.js":
                p = await asyncio.get_running_loop().run_in_executor(None, ensure_mermaid)
                if p is None:
                    return await reply(
                        writer, "503 Service Unavailable", "text/plain",
                        "mermaid.js not cached and download failed",
                    )
                return await reply(writer, "200 OK", "application/javascript", p.read_bytes())
            if path.startswith("/chart/"):
                name = path[len("/chart/"):]
                chart = DIR / "charts" / f"{name}.mmd"
                if not NAME_RE.match(name) or not chart.exists():
                    return await reply(writer, "404 Not Found", "text/plain", "no such chart")
                return await reply(writer, "200 OK", "text/plain; charset=utf-8", chart.read_text())
            if path == "/merges":
                return await reply(writer, "200 OK", "application/json", json.dumps(self.store.merges))
            if path == "/events":
                q = asyncio.Queue(maxsize=20)
                self.clients.add(q)
                writer.write(
                    b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n"
                    b"Cache-Control: no-cache\r\nConnection: keep-alive\r\n\r\n"
                )
                await writer.drain()
                try:
                    while True:
                        entry = await q.get()
                        writer.write(("data: " + json.dumps(entry) + "\n\n").encode())
                        await writer.drain()
                finally:
                    self.clients.discard(q)
                    with contextlib.suppress(OSError):
                        writer.close()
                return
            await reply(writer, "404 Not Found", "text/plain", "nope")
        except (OSError, asyncio.TimeoutError, asyncio.IncompleteReadError):
            pass
        finally:
            with contextlib.suppress(Exception):
                writer.close()

    async def fs_poll(self):
        inbox = DIR / "current.mmd"
        try:
            st = inbox.stat()
            seen = (st.st_mtime_ns, st.st_size)
        except OSError:
            seen = None
        while True:
            await asyncio.sleep(0.4)
            try:
                st = inbox.stat()
            except OSError:
                continue
            key = (st.st_mtime_ns, st.st_size)
            if key == seen:
                continue
            seen = key
            mmd = inbox.read_text().strip()
            if mmd and (not self.store.hist or self.store.hist[-1]["mmd"] != mmd):
                entry = self.store.append("scratch", mmd)
                await self.broadcast(entry)

    async def run(self):
        if SOCK.exists():
            SOCK.unlink()
        sock_srv = await asyncio.start_unix_server(self.handle_sock, str(SOCK))
        http_srv = await asyncio.start_server(self.handle_http, "127.0.0.1", PORT)
        poll = asyncio.create_task(self.fs_poll())
        print(f"lagoon: socket {SOCK}  http://127.0.0.1:{PORT}/", flush=True)
        try:
            await asyncio.Event().wait()
        finally:
            poll.cancel()
            sock_srv.close()
            http_srv.close()
            with contextlib.suppress(OSError):
                SOCK.unlink()


