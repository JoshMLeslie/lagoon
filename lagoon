function exitRebind() {
  if (!rebind) return;
  rebind = null;
  document.body.classList.remove("rebind");
  for (const h of [...document.querySelectorAll(".lagoon-handle")]) h.remove();
}

const escRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

function edgeSourceInfo(edge) {
  // shared by re-point / delete / label editing: the source line behind a
  // rendered edge. Returns { e, lines, idx, src, tgt } or an error string.
  const e = viewList()[cursor];
  if (!e || e.name !== curChart) return "no source behind this view";
  const m = (edge.p.getAttribute("data-id") || "").match(/^L_([A-Za-z0-9._-]+)_([A-Za-z0-9._-]+)_(\d+)$/);
  if (!m) return "can't identify this edge in the source";
  if (/linkStyle/i.test(e.mmd)) return "this chart uses linkStyle — edge edits disabled (indices would drift)";
  const lines = e.mmd.split("\n");
  const matches = [];
  for (let i = 0; i < lines.length; i++) {
    const ln = lines[i];
    if (ln.includes(m[1]) && ln.includes(m[2]) && EDGE_OP_TEST.test(ln)) matches.push(i);
  }
  const idx = matches[+m[3]] !== undefined ? matches[+m[3]] : matches[0];
  if (idx === undefined) return "can't find this edge's source line";
  if ((lines[idx].match(EDGE_OP_RE) || []).length > 1)
    return "chained-edge lines can't be edited — split the line first";
  return { e, lines, idx, src: m[1], tgt: m[2] };
}

async function pushChart(name, mmd) {
  // the one commit path for re-point / delete / create / label edit
  try {
    const r = await fetch("/chart/" + encodeURIComponent(name), { method: "POST", body: mmd });
    return r.ok ? null : "HTTP " + r.status;
  } catch (err) {
    return String(err);
  }
}

async function rewriteEdge(edge, newTgt) {
  const info = edgeSourceInfo(edge);
  if (typeof info === "string") return $("pos").textContent = info;
  const { e, lines, idx, tgt } = info;
  const line = lines[idx];
  if (newTgt === null) {
    if (line.includes("&")) {
      if (new RegExp("\\s*&\\s*" + escRe(tgt) + "(?=\\s|$)").test(line))
        lines[idx] = line.replace(new RegExp("\\s*&\\s*" + escRe(tgt) + "(?=\\s|$)"), "");
      else if (new RegExp("(^|\\s)" + escRe(tgt) + "\\s*&\\s*").test(line))
        lines[idx] = line.replace(new RegExp("(^|\\s)" + escRe(tgt) + "\\s*&\\s*"), "$1");
    } else {
      lines.splice(idx, 1);
    }
  } else {
    lines[idx] = line.replace(new RegExp("(^|[\\s&])" + escRe(tgt) + "(?=[\\s&|]|$)"), (mm, pre) => pre + newTgt);
  }
  const err = await pushChart(e.name, lines.join("\n"));
  if (err) $("pos").textContent = "edge edit failed: " + err;
}

async function createEdge(src, tgt) {
  const e = viewList()[cursor];
  if (!e || e.name !== curChart) return;
  if (/linkStyle/i.test(e.mmd)) return $("pos").textContent = "this chart uses linkStyle — edge edits disabled (indices would drift)";
  const mmd = e.mmd.replace(/\s*$/, "") + "\n" + src + " --> " + tgt;
  const err = await pushChart(e.name, mmd);
  if (err) $("pos").textContent = "edge create failed: " + err;
}

function cancelLabelEdit() {
  if (!labelEdit) return;
  labelEdit.el.remove();
  labelEdit = null;
  $("pos").textContent = "";
}

async function commitLabelEdit() {
  const L = labelEdit;
  if (!L) return;
  const text = L.text.replace(/\s+$/, "");
  labelEdit = null;
  L.el.remove();
  if (text.includes("|")) { $("pos").textContent = "labels can't contain |"; return; }
  const info = edgeSourceInfo(L.edge);
  if (typeof info === "string") { $("pos").textContent = info; return; }
  const { e, lines, idx } = info;
  let line = lines[idx];
  const pipe = /\|[^|]*\|/.test(line);
  // dash-text forms: A -- text --> B · A -. text .-> B · A == text ==> B
  const dashTxt = line.match(/--\s+\S.*?\s+-->/) || line.match(/-\.\s+\S.*?\s+\.->/) || line.match(/==\s+\S.*?\s+==>/);
  if (text === "" && (pipe || dashTxt)) {
    // cleared: strip the label token entirely
    line = pipe ? line.replace(/\s*\|[^|]*\|/g, "")
      : line.replace(dashTxt[0], dashTxt[0].startsWith("--") ? "-->" : dashTxt[0].startsWith("==") ? "==>" : "-.->");
  } else if (pipe) {
    line = line.replace(/\|[^|]*\|/, "|" + text + "|");
  } else if (dashTxt) {
    line = line.replace(dashTxt[0],
      dashTxt[0].startsWith("--") ? "-- " + text + " -->"
      : dashTxt[0].startsWith("==") ? "== " + text + " ==>"
      : "-. " + text + " .->");
  } else if (text !== "") {
    const op = EDGE_OP_TEST.exec(line);  // no label yet: tuck |text| right after the arrow
    if (!op) { $("pos").textContent = "can't place a label on this line"; return; }
    line = line.slice(0, op.index + op[0].length) + "|" + text + "|" + line.slice(op.index + op[0].length);
  }
  if (line === lines[idx]) { $("pos").textContent = "label unchanged"; return; }
  lines[idx] = line;
  const err = await pushChart(e.name, lines.join("\n"));
  if (err) $("pos").textContent = "label edit failed: " + err;
}

function editEdgeLabel(edge) {
  cancelLabelEdit();
  exitRebind();
  const info = edgeSourceInfo(edge);
  if (typeof info === "string") { $("pos").textContent = info; return; }
  const src = info.lines[info.idx];
  const pipe = src.match(/\|([^|]*)\|/);
  const dash = src.match(/--\s+(\S.*?)\s+-->/) || src.match(/-\.\s+(\S.*?)\s+\.->/) || src.match(/==\s+(\S.*?)\s+==>/);
  const pre = pipe ? pipe[1] : dash ? dash[1] : "";
  const r = edge.lbl.getBoundingClientRect();
  const sr = stage.getBoundingClientRect();
  const el = document.createElement("div");
  el.className = "lagoon-edit";
  el.textContent = pre;
  el.style.left = Math.max(4, r.left - sr.left - 16) + "px";
  el.style.top = Math.max(4, r.top - sr.top - 4) + "px";
  stage.appendChild(el);
  labelEdit = { el, text: pre, edge };
  $("pos").textContent = "enter saves · esc or click away cancels · clear-all + enter removes the label";
}

function enterRebind(node) {
  exitRebind();
  const out = layout ? layout.edges.filter((e) => e.src === node) : [];
  rebind = { src: node };
  document.body.classList.add("rebind");
  $("pos").textContent = out.length
    ? "drag an X to re-point · click it to delete · drag from this cell to create · Esc cancels"
    : "no outgoing edges from this cell — drag from it to create one · Esc cancels";
  const NS = "http://www.w3.org/2000/svg";
  for (const e of out) {
    // read the LIVE rendered path start — node offsets have already remapped it,
    // so the original dagre numbers would put the X at a stale position
    const live = (e.p.getAttribute("d") || "").match(/-?[\d.]+/g);
    if (!live) continue;
    const cx = +live[0], cy = +live[1];
    // slide outward along the line's first segment so the X sits on the line,
    // just clear of the node — the grab zone was half-inside the node before
    const dx = +live[2] - cx, dy = +live[3] - cy;
    const len = Math.hypot(dx, dy) || 1;
    const d = Math.min(12, len / 2);
    const hx = cx + (dx / len) * d, hy = cy + (dy / len) * d;
    const g = document.createElementNS(NS, "g");
    g.setAttribute("class", "lagoon-handle");
    const hit = document.createElementNS(NS, "circle");
    hit.setAttribute("cx", hx); hit.setAttribute("cy", hy); hit.setAttribute("r", 7);
    hit.setAttribute("fill", "transparent");
    hit.setAttribute("pointer-events", "all");
    const x = document.createElementNS(NS, "path");
    x.setAttribute("d", "M " + (hx - 5) + " " + (hy - 5) + " L " + (hx + 5) + " " + (hy + 5) + " M " + (hx + 5) + " " + (hy - 5) + " L " + (hx - 5) + " " + (hy + 5));
    g.appendChild(hit);
    g.appendChild(x);
    g.addEventListener("pointerdown", (ev) => {
      ev.stopPropagation();
      ev.preventDefault();
      let moved = false;
      const onMove = () => { moved = true; };
      const onUp = async (ev2) => {
        window.removeEventListener("pointermove", onMove);
        exitRebind();
        if (!moved) { await rewriteEdge(e, null); return; }
        const rec = closest(document.elementFromPoint(ev2.clientX, ev2.clientY), "g.node");
        if (rec && layout && layout.svg.contains(rec)) await rewriteEdge(e, nodeKey(rec));
      };
      window.addEventListener("pointermove", onMove);
      window.addEventListener("pointerup", onUp, { once: true });
    });
    layout.svg.appendChild(g);
  }
}

async function copySource() {
  if (splitNames()) return;
  const e = viewList()[cursor];
  if (!e) return;
  try {
    await navigator.clipboard.writeText(e.mmd);
