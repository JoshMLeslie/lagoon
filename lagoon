KEYCODES = {
    # Primary map: macOS virtual keycodes. charactersIgnoringModifiers lies
    # under modifiers (shift+tab reports backtab \x19, not \t), but the raw
    # keycode is stable for every key the page cares about.
    123: "ArrowLeft", 124: "ArrowRight", 125: "ArrowDown", 126: "ArrowUp",
    48: "Tab", 36: "Enter", 76: "Enter", 53: "Escape",
    51: "Backspace", 49: " ", 117: "Delete",
    115: "Home", 119: "End", 116: "PageUp", 121: "PageDown",
}
KEY_MAP = {
    # Fallback for printable keys via charactersIgnoringModifiers.
    # AppKit function-key unichars: F700=up F701=down F702=left F703=right
    # F728=Delete F729=Home F72B=End F72C=PageUp F72D=PageDown.
    "": "ArrowUp", "": "ArrowDown",
    "": "ArrowLeft", "": "ArrowRight",
    "": "Home", "": "End",
    "": "PageUp", "": "PageDown",
    "": "Delete",
    "\x19": "Tab", "\t": "Tab", "\r": "Enter", "\x03": "Enter",
    "\x1b": "Escape", "\x08": "Backspace", " ": " ",
}


def find_webview(win):
    try:
        import WebKit
    except ImportError:
        return None
    stack = [win.contentView()]
    while stack:
        v = stack.pop()
        if v is None:
            continue
        if v.isKindOfClass_(WebKit.WKWebView):
            return v
        stack.extend(list(v.subviews()))
    return None


def install_key_forwarding():
    # Own the whole key path: NSApp.sendEvent sees every key event before
    # WebKit's responder chain, which never delivered arrows reliably.
    # Forward each non-command keydown into the webview as a synthetic
    # KeyboardEvent and consume it natively, so nothing beeps.
    try:
        import AppKit
        import objc

        class LagoonApplication(AppKit.NSApplication):
            def sendEvent_(self, event):
                try:
                    if event.type() == AppKit.NSKeyDown:
                        mods = event.modifierFlags()
                        if not mods & AppKit.NSEventModifierFlagCommand:
                            win = self.keyWindow()
                            wv = find_webview(win) if win is not None else None
                            if wv is not None:
                                kc = event.keyCode()
                                chars = event.charactersIgnoringModifiers() or ""
                                key = KEYCODES.get(kc)
                                if key is None and len(event.characters() or "") == 1:
                                    # characters() keeps shift, so typing into the
                                    # on-chart label editor yields real symbols
                                    key = KEY_MAP.get(chars, event.characters())
                                with contextlib.suppress(OSError):
                                    with open(DIR / "keys.log", "a") as f:
                                        f.write(utcnow() + " kc=" + str(kc) + " chars=" + repr(chars) + " key=" + repr(key) + "\n")
                                if key:
                                    js = (
                                        "window.dispatchEvent(new KeyboardEvent('keydown',{key:"
                                        + json.dumps(key)
                                        + ",ctrlKey:" + ("true" if mods & AppKit.NSEventModifierFlagControl else "false")
                                        + ",altKey:" + ("true" if mods & AppKit.NSEventModifierFlagOption else "false")
                                        + ",shiftKey:" + ("true" if mods & AppKit.NSEventModifierFlagShift else "false")
                                        + "}));"
                                    )
                                    wv.evaluateJavaScript_completionHandler_(js, None)
                                    return
                except Exception:
                    pass
                objc.super(LagoonApplication, self).sendEvent_(event)

        LagoonApplication.sharedApplication()
        with contextlib.suppress(OSError):
            (DIR / "panel-patch.log").write_text("sendEvent ok")
            (DIR / "keys.log").write_text("")
    except Exception as e:
        with contextlib.suppress(OSError):
            (DIR / "panel-patch.log").write_text(repr(e))


def focus_webview():
    # pywebview fires events off the main thread; AppKit calls from there crash
    try:
        from PyObjCTools import AppHelper
        AppHelper.callAfter(focus_webview_main)
    except Exception:
        pass


def focus_webview_main():
    try:
        from AppKit import NSApp
        NSApp.activateIgnoringOtherApps_(True)
        win = NSApp.keyWindow() or NSApp.mainWindow()
        if win is None:
            return
        win.makeKeyAndOrderFront_(None)
        v = find_webview(win)
        if v is not None:
            win.makeFirstResponder_(v)
    except Exception:
        pass


def cmd__panel(args):
    if sys.platform == "darwin":
        install_key_forwarding()
    import webview

    windows = []
    if len(args.names) == 2:
        windows.append(webview.create_window(
            "Lagoon", f"http://127.0.0.1:{PORT}/#{args.names[0]}+{args.names[1]}",
            width=920, height=520, min_size=(480, 320), js_api=PanelApi(),
        ))
    else:
        for name in args.names or [None]:
            url = f"http://127.0.0.1:{PORT}/" + (f"#{name}" if name else "")
            windows.append(webview.create_window(
                "Lagoon", url, width=520, height=440, min_size=(320, 240), js_api=PanelApi()
            ))
    if sys.platform == "darwin":
        for w in windows:
            w.events.shown += focus_webview
    webview.start()


def cmd_open(args):
    ensure_daemon()
    webbrowser.open(f"http://127.0.0.1:{PORT}/")


def cmd_push(args):
    if bad_name(args.name):
        exit_bad_name()
    data = sys.stdin.read()
    if not data.strip():
        sys.exit("lagoon: empty stdin")
    resp = ask(f"push {args.name}\n{data}\n")
    print(f"pushed {resp['name']} (ver {resp['ver']})")


def cmd_show(args):
    if bad_name(args.name):
        exit_bad_name()
    resp = ask(f"show {args.name}\n")
    print(f"showing {resp['name']} (ver {resp['ver']})")


def cmd_list(args):
    resp = ask("list\n")
    for name in resp["charts"]:
        print(("* " if name == resp.get("current") else "  ") + name)
    for mid in resp.get("merges", []):
        print("= " + mid)


def cmd_unmerge(args):
    parts = args.id.split("+")
    if len(parts) < 2 or any(bad_name(p) for p in parts):
        sys.exit("lagoon: merged view ids look like 'chart-a+chart-b'")
    resp = ask(f"unmerge {args.id}\n")
    print("removed merged view " + resp["removed"])


def cmd_compare(args):
    if len(args.names) < 2:
        sys.exit("lagoon: compare needs 2+ chart names")
    for n in args.names:
        if bad_name(n):
            exit_bad_name()
    resp = ask("compare " + " ".join(args.names) + "\n")
    print("comparing " + " | ".join(resp["charts"]) + f" ({resp['panels']} panel(s) connected)")


def cmd_offsets(args):
    if bad_name(args.name):
        exit_bad_name()
    resp = ask(f"offsets {args.name}\n")
    print(json.dumps(resp["offsets"], indent=2))


def cmd_history(args):
    name = args.name or ""
    if name and bad_name(name):
        exit_bad_name()
    resp = ask(("history " + name).strip() + "\n")
    for e in resp["entries"]:
        print(f"{e['ver']:>4}  {e['at']}  {e['name']}")


def main():
    ap = argparse.ArgumentParser(
        prog="lagoon",
        description="a small floating mermaid portal",
        epilog=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("serve", help="run the daemon")
    p = sub.add_parser("panel", help="open panel window(s); names pin individual charts")
    p.add_argument("names", nargs="*")
    sub.add_parser("open", help="open the portal in a browser")
    p = sub.add_parser("push", help="push mermaid from stdin")
    p.add_argument("name", nargs="?", default="scratch")
    p = sub.add_parser("show", help="bring a named chart back to the portal")
    p.add_argument("name")
    sub.add_parser("list", help="list charts (* marks current)")
    p = sub.add_parser("compare", help="open a split compare of 2+ charts on the portal")
    p.add_argument("names", nargs="+")
    p = sub.add_parser("offsets", help="print a chart's stored drag nudges")
    p.add_argument("name")
    p = sub.add_parser("history", help="print recent push history (all, or one chart)")
    p.add_argument("name", nargs="?")
    p = sub.add_parser("unmerge", help="remove a persisted merged view")
    p.add_argument("id")
    p = sub.add_parser("_panel", help=argparse.SUPPRESS)
    p.add_argument("names", nargs="*")
    args = ap.parse_args()
    {
        "serve": cmd_serve,
        "panel": cmd_panel,
        "_panel": cmd__panel,
        "open": cmd_open,
        "push": cmd_push,
        "show": cmd_show,
        "list": cmd_list,
        "compare": cmd_compare,
        "offsets": cmd_offsets,
        "history": cmd_history,
        "unmerge": cmd_unmerge,
    }[args.cmd](args)


if __name__ == "__main__":
    main()
