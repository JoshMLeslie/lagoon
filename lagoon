<script>
const $ = (id) => document.getElementById(id);
const stage = $("stage");
const closest = (el, sel) => el && el.closest ? el.closest(sel) : null;
if (window.self !== window.top) document.body.classList.add("embedded");
let hist = [];
let pinned = null;
let cursor = -1;
let selecting = false;
let selection = [];
let mergedList = [];
let scale = 1, tx = 0, ty = 0;
const seenVer = {};

const pinnedName = () => {
  const h = decodeURIComponent(location.hash.replace(/^#/, ""));
  return h && h !== "latest" && !h.includes("+") ? h : null;
};
const EDGE_OP_RE = /(<-{2,}|-{2,}>|-\.\->|-\.-|==>|={3})/g;
const EDGE_OP_TEST = new RegExp(EDGE_OP_RE.source);  // /g + .test() advances lastIndex across calls — scans intermittently miss lines
const SPLIT_RE = /^[A-Za-z0-9._-]+(\+[A-Za-z0-9._-]+)+$/;
const splitNames = () => {
  const h = decodeURIComponent(location.hash.replace(/^#/, ""));
  return SPLIT_RE.test(h) ? h.split("+") : null;
};
const viewList = () => (pinned === null ? hist : hist.filter((e) => e.name === pinned));
const tabNames = () => ["latest", ...new Set(hist.map((e) => e.name)), ...mergedList.map((m) => m.id)];
const currentTab = () => {
  const sp = splitNames();
  if (sp) return sp.join("+");
  if (pinned !== null) return pinned;
  const list = viewList();
  return list[cursor] && cursor < list.length - 1 ? list[cursor].name : "latest";
};

function show(text) {
  $("msg").hidden = false;
  $("msg").textContent = text;
  $("chart").innerHTML = "";
  $("pos").textContent = "";
}

function apply() {
  $("chart").style.transform = "translate(" + tx + "px," + ty + "px) scale(" + scale + ")";
}

function fit() {
  scale = 1; tx = 0; ty = 0; apply();
  const svg = $("chart").querySelector("svg");
  if (!svg) return;
  const st = stage.getBoundingClientRect();
  const cw = svg.getBoundingClientRect().width || 100;
  const ch = svg.getBoundingClientRect().height || 100;
  scale = Math.min((st.width - 24) / cw, (st.height - 24) / ch, 2);
  tx = (st.width - cw * scale) / 2;
  ty = (st.height - ch * scale) / 2;
  apply();
}

function zoomAt(px, py, factor) {
  const ns = Math.min(8, Math.max(0.05, scale * factor));
  tx = px - (px - tx) * (ns / scale);
  ty = py - (py - ty) * (ns / scale);
  scale = ns;
  apply();
}

function zoomCenter(f) {
  const r = stage.getBoundingClientRect();
  zoomAt(r.width / 2, r.height / 2, f);
}

let offsets = {};
let legacyEdges = false;  // per-chart escape hatch: keep dagre's routed paths instead of the swoopy cubic
let curChart = null;
let layout = null;
let nodeDrag = null;

const nodeKey = (g) => (g.id.match(/flowchart-(.*)-\d+$/) || [])[1] || g.id;
const clusterKey = (g) => {
  const i = g.id.indexOf("-");
  return i > 0 ? g.id.slice(i + 1) : g.id;
};
const armDrag = (ev, st) => Math.abs(ev.clientX - st.x) + Math.abs(ev.clientY - st.y) >= 3;
const keyOf = (g) => (g.classList.contains("cluster") ? clusterKey(g) : nodeKey(g));
const offOf = (el) => offsets[keyOf(el)] || [0, 0];
const totalOffset = (g) => {
  let x = 0, y = 0, cur = g;
  while (cur && cur.tagName === "g") {
    const o = offOf(cur);
    x += o[0]; y += o[1];
    cur = cur.parentElement;
  }
  return [x, y];
};

async function loadFlags(name) {
  try {
    const o = await (await fetch("/flags/" + encodeURIComponent(name))).json();
    legacyEdges = !!o.legacyEdges;
    $("legacy").checked = legacyEdges;
  } catch (err) { }
}

async function loadOffsets(name) {
  offsets = {};
  try {
    offsets = await (await fetch("/offsets/" + encodeURIComponent(name))).json();
  } catch (err) {
    try {
      const raw = localStorage.getItem("lagoon-offsets-" + name);
      if (raw) offsets = JSON.parse(raw);
    } catch (err2) { }
  }
}

function saveOffsets() {
  if (!curChart) return;
  try { localStorage.setItem("lagoon-offsets-" + curChart, JSON.stringify(offsets)); } catch (err) { }
  fetch("/offsets/" + encodeURIComponent(curChart),
        { method: "POST", body: JSON.stringify(offsets) }).catch(() => { });
}

const offsetStacks = {};
function stackOf(name) {
  if (!offsetStacks[name]) offsetStacks[name] = { stack: [], idx: -1 };
  return offsetStacks[name];
}
function pushOffsetSnapshot() {
  if (!curChart) return;
  const s = stackOf(curChart);
  s.stack = s.stack.slice(0, s.idx + 1);
  s.stack.push(JSON.stringify(offsets));
  s.idx = s.stack.length - 1;
}
function restoreOffsets(i) {
  const s = stackOf(curChart);
  s.idx = i;
  offsets = JSON.parse(s.stack[i]);
  applyAll();
  saveOffsets();
}
function undoLayout() {
  if (splitNames()) return;
  const s = stackOf(curChart);
  if (s.idx > 0) restoreOffsets(s.idx - 1);
  updateLayoutBtns();
}
function redoLayout() {
  if (splitNames()) return;
  const s = stackOf(curChart);
  if (s.idx < s.stack.length - 1) restoreOffsets(s.idx + 1);
  updateLayoutBtns();
}
function resetLayout() {
  if (splitNames()) return;
  offsets = {};
  saveOffsets();
  const s = stackOf(curChart);
  s.stack = [];
  s.idx = -1;
  applyAll();
  updateLayoutBtns();
}
function updateLayoutBtns() {
  if (splitNames()) { $("reset").hidden = true; $("undo").hidden = true; $("redo").hidden = true; return; }
  const dirty = Object.keys(offsets).length > 0;
  const s = curChart ? stackOf(curChart) : null;
  $("reset").hidden = !dirty;
  $("undo").hidden = !dirty || !s || s.idx <= 0;
  $("redo").hidden = !dirty || !s || s.idx >= s.stack.length - 1;
}

function pathEnds(d) {
  const n = d.match(/-?[\d.]+/g).map(Number);
  return [[n[0], n[1]], [n[n.length - 2], n[n.length - 1]]];
}

function buildLayout() {
  const svg = $("chart").querySelector("svg");
  if (!svg) { layout = null; return; }
  const nodes = [...svg.querySelectorAll("g.node")];
  const clusters = [...svg.querySelectorAll("g.cluster")];
  const anchor = new Map();
  for (const g of nodes) {
    const m = (g.getAttribute("transform") || "").match(/translate\(\s*(-?[\d.e]+)[ ,]+(-?[\d.e]+)/);
    anchor.set(g, m ? [+m[1], +m[2]] : [0, 0]);
  }
  const nearest = (pt) => {
    let best = null, bd = Infinity;
    for (const [g, a] of anchor) {
      const d = (a[0] - pt[0]) ** 2 + (a[1] - pt[1]) ** 2;
      if (d < bd) { bd = d; best = g; }
    }
    return best;
  };
  const nodeById = new Map();
  for (const g of nodes) nodeById.set(nodeKey(g), g);
  const bindById = (id) => {
    // the edge's own data-id names both nodes — trust it before geometry:
    // a big node's border point can sit closer to ANOTHER node's center than
    // its own (misbinds cross-cluster edges as self-loops, which never redraw)
    const m = id.match(/^L_(.+)_(\d+)$/);
    if (!m) return null;
    const mid = m[1];
    for (let cut = mid.indexOf("_"); cut > 0; cut = mid.indexOf("_", cut + 1)) {
      const s = nodeById.get(mid.slice(0, cut)), t = nodeById.get(mid.slice(cut + 1));
      if (s && t) return [s, t];
    }
    return null;
  };
  const labelHost = new Map();
  const edges = [...svg.querySelectorAll("g.edgePaths path[data-id]")]
    .filter((p) => p.getAttribute("d"))
    .map((p) => {
      const d = p.getAttribute("d");
      const nums = [];
      const skel = d.replace(/-?[\d.]+/g, (m) => (nums.push(+m), "\x01" + (nums.length - 1)));
      const ends = pathEnds(d);
      const byId = bindById(p.getAttribute("data-id"));
      return { p, d, skel, nums,
               src: byId ? byId[0] : nearest(ends[0]),
               tgt: byId ? byId[1] : nearest(ends[1]),
               lbl: null, lblT: null };
    });
  // mermaid tags the inner g.label with the edge's own data-id — exact binding,
  // no geometric guessing (nearby curves steal labels otherwise). The outer
  // g.edgeLabel holds the position transform; unlabeled edges have none.
  for (const lab of svg.querySelectorAll("g.edgeLabel g.label[data-id]"))
    labelHost.set(lab.getAttribute("data-id"), lab.closest("g.edgeLabel"));
  for (const e of edges) {
    const host = labelHost.get(e.p.getAttribute("data-id"));
    if (!host) continue;
    const m = (host.getAttribute("transform") || "").match(/translate\(\s*(-?[\d.e]+)[ ,]+(-?[\d.e]+)/);
    if (m) { e.lbl = host; e.lblT = [+m[1], +m[2]]; }
  }
  const bbox = new Map();
  for (const g of nodes) {
    const shape = [...g.children].find((c) => !["g", "text", "foreignObject"].includes(c.tagName.toLowerCase()));
    if (shape) { const bb = shape.getBBox(); bbox.set(g, [bb.width / 2, bb.height / 2]); }
  }
  const members = new Map();
  const rectOf = (c) => {
    const r = c.querySelector("rect");
    return r ? [+r.getAttribute("x"), +r.getAttribute("y"),
                +r.getAttribute("width"), +r.getAttribute("height")] : null;
  };
  for (const c of clusters) {
    const rc = rectOf(c);
    if (!rc) continue;
    const list = nodes.filter((g) => {
      const a = anchor.get(g);
      return a && a[0] >= rc[0] && a[0] <= rc[0] + rc[2] && a[1] >= rc[1] && a[1] <= rc[1] + rc[3];
    });
    if (list.length) members.set(c, list);
  }
  // box fit data: per-side padding between the original rect and its contents
  // (nodes + inner cluster rects), plus the label's offset from the box corner.
  // applyAll refits each rect around its contents, so a dragged/picked cell can
  // never end up outside its subgraph box.
  const pad = new Map(), labelOf = new Map(), innerOf = new Map();
  for (const c of clusters) {
    const rc = rectOf(c);
    if (!rc) continue;
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    const grow = (px0, py0, px1, py1) => {
      if (px0 < x0) x0 = px0;
      if (py0 < y0) y0 = py0;
      if (px1 > x1) x1 = px1;
      if (py1 > y1) y1 = py1;
    };
    for (const g of members.get(c) || []) {
      const a = anchor.get(g), bb = bbox.get(g) || [40, 20];
      grow(a[0] - bb[0], a[1] - bb[1], a[0] + bb[0], a[1] + bb[1]);
    }
    const inners = [];
    for (const other of clusters) {
      if (other === c) continue;
      const ro = rectOf(other);
      if (!ro) continue;
      if (ro[0] >= rc[0] && ro[1] >= rc[1] && ro[0] + ro[2] <= rc[0] + rc[2] && ro[1] + ro[3] <= rc[1] + rc[3]) {
        inners.push(other);
        grow(ro[0], ro[1], ro[0] + ro[2], ro[1] + ro[3]);
      }
    }
    if (x0 === Infinity) continue;
    innerOf.set(c, inners);
    pad.set(c, [x0 - rc[0], y0 - rc[1], (rc[0] + rc[2]) - x1, (rc[1] + rc[3]) - y1]);
    const lab = c.querySelector("g.cluster-label");
    const m = lab && (lab.getAttribute("transform") || "").match(/translate\(\s*(-?[\d.e]+)[ ,]+(-?[\d.e]+)/);
    if (m) labelOf.set(c, [+m[1] - rc[0], +m[2] - rc[1]]);
  }
  clusters.sort((a, b) => (rectOf(a) || [0, 0, 0, 0])[2] * (rectOf(a) || [0, 0, 0, 1])[3]
                         - (rectOf(b) || [0, 0, 0, 0])[2] * (rectOf(b) || [0, 0, 0, 1])[3]);  // inner boxes first
  layout = { svg, nodes, clusters, anchor, bbox, edges, members, pad, labelOf, innerOf };
}

function borderPoint(cx, cy, hw, hh, dirx, diry) {
  // where the center→target line crosses this node's rect
  return Math.min(hw / Math.abs(dirx || 1e-9), hh / Math.abs(diry || 1e-9));
}

function affineRemap(nums, s, t) {
  // legacy-mode drag: stretch the original bezier chain between moved anchors,
  // preserving dagre's routing shape
  const n = nums.length;
  const x0 = nums[0] + s[0], y0 = nums[1] + s[1];
  const xn = nums[n - 2] + t[0], yn = nums[n - 1] + t[1];
  const out = nums.slice();
  const ux = nums[n - 2] - nums[0], uy = nums[n - 1] - nums[1];
  const L2 = ux * ux + uy * uy || 1;
  for (let i = 2; i < n - 2; i += 2) {
    const u = ((nums[i] - nums[0]) * ux + (nums[i + 1] - nums[1]) * uy) / L2;
    out[i] = x0 + (xn - x0) * u + (nums[i] - (nums[0] + ux * u));
    out[i + 1] = y0 + (yn - y0) * u + (nums[i + 1] - (nums[1] + uy * u));
  }
  out[0] = x0; out[1] = y0; out[n - 2] = xn; out[n - 1] = yn;
  return out;
}

function applyEdge(e) {
  const s = e.src ? totalOffset(e.src) : [0, 0];
  const t = e.tgt ? totalOffset(e.tgt) : [0, 0];
  if (legacyEdges) {
    if (!s[0] && !s[1] && !t[0] && !t[1]) {
      e.p.setAttribute("d", e.d);
      if (e.lbl && e.lblT) e.lbl.setAttribute("transform", "translate(" + e.lblT[0] + "," + e.lblT[1] + ")");
      return;
    }
    const out = affineRemap(e.nums, s, t);
    e.p.setAttribute("d", e.skel.replace(/\x01(\d+)/g, (_, i) => out[+i]));
    if (e.lbl && e.lblT) e.lbl.setAttribute("transform", "translate(" + (e.lblT[0] + (s[0] + t[0]) / 2) + "," + (e.lblT[1] + (s[1] + t[1]) / 2) + ")");
    return;
  }
  // self-loops (and edges whose endpoints didn't resolve) have no
  // center-to-center direction to anchor on — keep dagre's loop, translated
  if (e.src === e.tgt || !e.src || !e.tgt) {
    const out = e.nums.slice();
    for (let i = 0; i < out.length; i += 2) { out[i] += s[0]; out[i + 1] += s[1]; }
    e.p.setAttribute("d", e.skel.replace(/\x01(\d+)/g, (_, i) => out[+i]));
    if (e.lbl && e.lblT)
      e.lbl.setAttribute("transform", "translate(" + (e.lblT[0] + s[0]) + "," + (e.lblT[1] + s[1]) + ")");
    return;
  }
  // default: one edge model everywhere — dagre places nodes, we always draw the
  // border-anchored swoopy cubic, so a first drag moves numbers inside the
  // same model instead of swapping the whole path shape
  const a = layout.anchor.get(e.src), b = layout.anchor.get(e.tgt);
  const sa = layout.bbox.get(e.src) || [40, 20], ba = layout.bbox.get(e.tgt) || [40, 20];
  const cx0 = a[0] + s[0], cy0 = a[1] + s[1], cxn = b[0] + t[0], cyn = b[1] + t[1];
  const dx = cxn - cx0, dy = cyn - cy0, L = Math.hypot(dx, dy) || 1;
  const off0 = borderPoint(cx0, cy0, sa[0], sa[1], dx / L, dy / L);
  const offn = borderPoint(cxn, cyn, ba[0], ba[1], dx / L, dy / L);
  const x0 = cx0 + (dx / L) * off0, y0 = cy0 + (dy / L) * off0;
  const xn = cxn - (dx / L) * offn, yn = cyn - (dy / L) * offn;
  // one graceful cubic between the border points: control arms along the
  // dominant axis, so the line swoops instead of zig-zagging
  let c1x, c1y, c2x, c2y;
  if (Math.abs(dx) >= Math.abs(dy)) { c1x = x0 + (xn - x0) / 3; c1y = y0; c2x = xn - (xn - x0) / 3; c2y = yn; }
  else { c1x = x0; c1y = y0 + (yn - y0) / 3; c2x = xn; c2y = yn - (yn - y0) / 3; }
  e.p.setAttribute("d", "M " + x0 + "," + y0 + " C " + c1x + "," + c1y + " " + c2x + "," + c2y + " " + xn + "," + yn);
  if (e.lbl && e.lblT)
    e.lbl.setAttribute("transform", "translate(" + (x0 + 3 * c1x + 3 * c2x + xn) / 8 + "," + (y0 + 3 * c1y + 3 * c2y + yn) / 8 + ")");
}



function applyAll() {
  if (!layout) return;
  for (const g of layout.nodes) {
    const a = layout.anchor.get(g);
    const o = totalOffset(g);
    g.setAttribute("transform", "translate(" + (a[0] + o[0]) + "," + (a[1] + o[1]) + ")");
  }
  for (const c of layout.clusters) {
    const p = layout.pad.get(c);
    if (!p) {  // no measurable contents (empty subgraph): fall back to nudging the whole box
      const o = totalOffset(c);
      if (o[0] || o[1]) c.setAttribute("transform", "translate(" + o[0] + "," + o[1] + ")");
      else c.removeAttribute("transform");
      continue;
    }
    // the box always contains its contents: refit around current member
    // positions (inner clusters were refitted earlier — the area sort in
    // buildLayout guarantees it). Fitted boxes carry no transform of their
    // own; cluster drags already mirror their delta into member offsets.
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    const grow = (px0, py0, px1, py1) => {
      if (px0 < x0) x0 = px0;
      if (py0 < y0) y0 = py0;
      if (px1 > x1) x1 = px1;
      if (py1 > y1) y1 = py1;
    };
    for (const g of layout.members.get(c) || []) {
      const a = layout.anchor.get(g), bb = layout.bbox.get(g) || [40, 20], o = totalOffset(g);
      grow(a[0] + o[0] - bb[0], a[1] + o[1] - bb[1], a[0] + o[0] + bb[0], a[1] + o[1] + bb[1]);
    }
    for (const inner of layout.innerOf.get(c) || []) {
      const r = inner.querySelector("rect");
      if (!r) continue;
      const io = layout.pad.get(inner) ? [0, 0] : totalOffset(inner);
      grow(+r.getAttribute("x") + io[0], +r.getAttribute("y") + io[1],
           +r.getAttribute("x") + io[0] + +r.getAttribute("width"),
           +r.getAttribute("y") + io[1] + +r.getAttribute("height"));
    }
    const x = x0 - p[0], y = y0 - p[1];
    const r = c.querySelector("rect");
    r.setAttribute("x", x);
    r.setAttribute("y", y);
    r.setAttribute("width", (x1 + p[2]) - x);
    r.setAttribute("height", (y1 + p[3]) - y);
    c.removeAttribute("transform");
    const ld = layout.labelOf.get(c);
    const lab = c.querySelector("g.cluster-label");
    if (ld && lab) lab.setAttribute("transform", "translate(" + (x + ld[0]) + "," + (y + ld[1]) + ")");
  }
  for (const e of layout.edges) applyEdge(e);
}

let rebind = null;
let createDrag = null;
let ghost = null;
let labelEdit = null;
let marquee = null;
const picked = new Set();  // shift-selected cells; dragging any one moves the whole set

function markPicked() {
  if (!layout) return;
  for (const g of layout.nodes) g.classList.toggle("sel", picked.has(g));
