def make_app_bundle():
    app = Path.home() / "Applications" / "Lagoon.app"
    mac = app / "Contents" / "MacOS"
    res = app / "Contents" / "Resources"
    mac.mkdir(parents=True, exist_ok=True)
    res.mkdir(parents=True, exist_ok=True)
    exe = mac / "lagoon-panel"
    (app / "Contents" / "Info.plist").write_text(APP_PLIST)
    src = res / "launcher.c"
    src.write_text(LAUNCHER_C)
    # LaunchServices on recent macOS will not exec shell-script bundle executables
    r = subprocess.run(["cc", "-O2", "-o", str(exe), str(src)], capture_output=True)
    if r.returncode != 0:
        r = subprocess.run(["clang", "-O2", "-o", str(exe), str(src)], capture_output=True)
    if r.returncode != 0:
        exe.write_text(
            "#!/bin/sh\n"
            'exec "$HOME/.local/state/lagoon/venv/bin/python" "$HOME/.local/bin/lagoon" _panel "$@"\n'
        )
        exe.chmod(0o755)
    icns = res / "lagoon.icns"
    if not icns.exists():
        pdf = res / "lagoon.pdf"
        pdf.write_bytes(icon_pdf())
        master = res / "lagoon-1024.png"
        subprocess.run(
            ["sips", "-s", "format", "png", "-z", "1024", "1024", str(pdf), "--out", str(master)],
            check=True, capture_output=True,
        )
        iconset = res / "lagoon.iconset"
        iconset.mkdir(exist_ok=True)
        for s in (16, 32, 128, 256, 512):
            for suffix, dim in (("", s), ("@2x", s * 2)):
                subprocess.run(
                    ["sips", "-s", "format", "png", "-z", str(dim), str(dim), str(master), "--out",
                     str(iconset / f"icon_{s}x{s}{suffix}.png")],
                    check=True, capture_output=True,
                )
        subprocess.run(
            ["iconutil", "-c", "icns", str(iconset), "-o", str(icns)],
            check=True, capture_output=True,
        )
        shutil.rmtree(iconset, ignore_errors=True)
        pdf.unlink(missing_ok=True)
        master.unlink(missing_ok=True)
    return app


def daemon_running():
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(0.5)
            s.connect(str(SOCK))
            s.sendall(b"list\n")
            s.shutdown(socket.SHUT_WR)
            return bool(s.recv(4096))
    except OSError:
        return False


def sock_request(payload):
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(10)
            s.connect(str(SOCK))
            s.sendall(payload.encode())
            s.shutdown(socket.SHUT_WR)
            buf = b""
            while chunk := s.recv(65536):
                buf += chunk
    except OSError:
        sys.exit("lagoon: daemon not running — start it with: lagoon panel (or lagoon serve)")
    with contextlib.suppress(json.JSONDecodeError):
        return json.loads(buf)
    sys.exit(f"lagoon: bad response: {buf[:200]!r}")


def ask(payload):
    resp = sock_request(payload)
    if not resp.get("ok"):
        sys.exit("lagoon: " + str(resp.get("error")))
    return resp


def ensure_daemon():
    if daemon_running():
        return
    DIR.mkdir(parents=True, exist_ok=True)
    log = open(DIR / "serve.log", "ab")
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "serve"],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=log,
    )
    log.close()
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        if daemon_running():
            return
        time.sleep(0.1)
    sys.exit(f"lagoon: daemon did not start — see {DIR / 'serve.log'}")


def panel_python():
    venv = DIR / "venv"
    py = venv / "bin" / "python"
    if py.exists():
        r = subprocess.run([str(py), "-c", "import webview"], capture_output=True)
        if r.returncode == 0:
            return py
    venv.mkdir(parents=True, exist_ok=True)
    base = sys.executable
    if sys.platform == "darwin":
        # non-framework pythons leak keyboard focus to other apps (pywebview FAQ)
        for cand in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
            try:
                out = subprocess.run(
                    [cand, "-c", "import sysconfig; print(sysconfig.get_config_var('PYTHONFRAMEWORK') or '')"],
                    capture_output=True, text=True,
                )
            except OSError:
                continue
            if out.returncode == 0 and out.stdout.strip():
                base = cand
                break
    subprocess.run([base, "-m", "venv", str(venv)], check=True)
    subprocess.run(
        [str(py), "-m", "pip", "install", "--quiet", "--disable-pip-version-check", "pywebview"],
        check=True,
    )
    return py


def cmd_serve(args):
    if daemon_running():
        print("lagoon: already running")
        return
    DIR.mkdir(parents=True, exist_ok=True)
    (DIR / "charts").mkdir(exist_ok=True)
    try:
        asyncio.run(Daemon().run())
    except OSError as e:
        sys.exit(f"lagoon: cannot start: {e}")
    except KeyboardInterrupt:
        pass


def cmd_panel(args):
    for n in args.names:
        if bad_name(n):
            exit_bad_name()
    ensure_daemon()
    if len(args.names) >= 2:
        with contextlib.suppress(SystemExit):
            sock_request("merge " + " ".join(args.names) + "\n")
    py = panel_python()
    if sys.platform == "darwin" and not os.environ.get("LAGOON_DIR") and not os.environ.get("LAGOON_PORT"):
        app = make_app_bundle()
        subprocess.run(["open", "-n", "-a", str(app), "--args", *args.names], check=True)
        return
    r = subprocess.run([str(py), os.path.abspath(__file__), "_panel", *args.names])
    sys.exit(r.returncode)


